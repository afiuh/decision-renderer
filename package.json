{
  "name": "decision-renderer",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w packages/server\" \"npm run dev -w packages/client\"",
    "build": "npm run build -w packages/client",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run build && node --experimental-strip-types packages/server/src/index.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}